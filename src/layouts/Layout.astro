---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { contactDetails, type Locale, type SiteContent } from '../i18n/content';
import { cvMarkdownPath } from '../lib/cv-markdown';

interface Props {
  locale: Locale;
  content: SiteContent;
  path: string;
  title?: string;
  description?: string;
  /** Absolute canonical URL, for pages whose original lives on another site. Defaults to `path` on this site. */
  canonical?: string;
  /** Extra JSON-LD for the page (e.g. a BlogPosting). */
  jsonLd?: Record<string, unknown>;
  /** Markdown version of this page's CV. Defaults to the locale's main CV. */
  markdownPath?: string;
}

const { locale, content, path, title, description, canonical, jsonLd, markdownPath } = Astro.props;
const pageTitle = title ?? content.meta.title;
const pageDescription = description ?? content.meta.description;
const canonicalURL = canonical ? new URL(canonical) : new URL(path, Astro.site);
const gaId = import.meta.env.PUBLIC_GA_ID ?? '';
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? '';

// Person + their own product as one graph, so search engines and assistants get
// the current role, employer and skills without parsing the page.
const personId = new URL('/#person', Astro.site).href;
const personJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Luciano Perez Ruiz',
      jobTitle: 'IT / Technical Project Manager · Product Owner',
      description: content.meta.description.replace(/\u2011/g, '-'),
      url: Astro.site?.toString(),
      image: new URL('/og-image.png', Astro.site).href,
      email: `mailto:${contactDetails.email}`,
      sameAs: [contactDetails.linkedinUrl, 'https://github.com/lucianopr87'],
      worksFor: { '@type': 'Organization', name: 'Pipa Code Studio', url: 'https://pipacode.studio' },
      knowsAbout: [
        'IT Project Management',
        'Technical Project Management',
        'Product ownership',
        'Agile / Scrum delivery',
        'AI agent orchestration',
        'Claude Code',
        'Full Stack Development',
      ],
      knowsLanguage: [
        { '@type': 'Language', name: 'Spanish', alternateName: 'es' },
        { '@type': 'Language', name: 'English', alternateName: 'en' },
      ],
      address: { '@type': 'PostalAddress', addressLocality: 'Santa Fe', addressCountry: 'AR' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Tino',
      url: 'https://estudiantino.com.ar',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      creator: { '@id': personId },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="text/markdown" href={markdownPath ?? cvMarkdownPath[locale]} title="CV (Markdown)" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', gaId);
      </script>
    )}
    {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    {gaId && <CookieConsent content={content} locale={locale} />}
    <slot />
  </body>
</html>

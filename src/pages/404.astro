---
import Layout from '../layouts/Layout.astro';
import { content } from '../i18n/content';

const pageContent = content.es;
---

<Layout locale="es" content={pageContent} path="/404/">
  <main class="wrap flex min-h-[80vh] flex-col items-start justify-center gap-6">
    <span class="font-mono text-xs tracking-[0.08em] text-label">ERROR 404</span>
    <h1 class="text-[clamp(52px,8vw,104px)] leading-[0.95] font-medium tracking-[-0.045em]">404</h1>
    <p class="text-[clamp(20px,2.2vw,26px)] leading-[1.35] text-ink-soft">Página no encontrada / Page not found</p>
    <a href="/" class="mt-2 rounded-full bg-accent px-[22px] py-3.5 text-[15px] font-medium text-white hover:bg-accent-hover">
      Volver al inicio / Back home
    </a>
  </main>
</Layout>

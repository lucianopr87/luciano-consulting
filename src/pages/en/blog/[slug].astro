---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { content } from '../../../i18n/content';
import { getPublishedPosts, postJsonLd, postMeta } from '../../../lib/blog';
import { render } from 'astro:content';
import { Image } from 'astro:assets';

const locale = 'en';
const pageContent = content[locale];

export async function getStaticPaths() {
  const posts = await getPublishedPosts('en');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/en/blog/${post.id}/`;
const { canonicalUrl, canonicalSiteName } = post.data;
---

<Layout
  locale={locale}
  content={pageContent}
  path={path}
  canonical={canonicalUrl}
  jsonLd={postJsonLd(post, new URL(path, Astro.site))}
  title={`${post.data.title} — ${pageContent.meta.title}`}
  description={post.data.description}
>
  <Header locale={locale} content={pageContent} otherLocalePath="/blog/" />
  <main class="wrap pb-24 pt-[140px]">
    <article class="mx-auto flex max-w-[720px] flex-col">
      <a href="/en/blog/" class="self-start text-sm text-muted hover:text-accent">{pageContent.blog.backLink}</a>
      <span class="mt-10 font-mono text-xs tracking-[0.04em] text-muted">{postMeta(locale, post)}</span>
      <h1 class="mt-4 text-[clamp(34px,5vw,56px)] leading-[1.05] font-medium tracking-[-0.035em] text-pretty">
        {post.data.title}
      </h1>
      <p class="mt-5 text-sm text-muted">{pageContent.blog.byline} {post.data.author}</p>
      {
        canonicalUrl && (
          <p class="mt-2 text-sm text-muted" data-testid="republished-note">
            {pageContent.blog.republishedPrefix}{' '}
            <a href={canonicalUrl} class="underline underline-offset-2 hover:text-accent">
              {canonicalSiteName ?? new URL(canonicalUrl).hostname}
            </a>.
          </p>
        )
      }
      {
        post.data.coverImage && (
          <Image
            src={post.data.coverImage}
            alt={post.data.coverImageAlt ?? ''}
            format="webp"
            quality={80}
            class="mt-10 w-full rounded border border-line-2"
          />
        )
      }
      <div class="prose mt-10">
        <Content />
      </div>
    </article>
  </main>
  <Footer content={pageContent} locale={locale} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Booking from '../../components/Booking.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';

const locale = 'en';
const pageContent = content[locale];
---

<Layout locale={locale} content={pageContent} path="/en/booking/" title={pageContent.booking.heading}>
  <Header locale={locale} content={pageContent} otherLocalePath="/booking/" />
  <main>
    <Booking content={pageContent} />
  </main>
  <Footer content={pageContent} locale={locale} />
</Layout>

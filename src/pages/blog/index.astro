---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { content } from '../../i18n/content';
import { getPublishedPosts } from '../../lib/blog';

const locale = 'es';
const pageContent = content[locale];
const posts = await getPublishedPosts(locale);
---

<Layout
  locale={locale}
  content={pageContent}
  path="/blog/"
  title={`${pageContent.blog.heading} — ${pageContent.meta.title}`}
  description={pageContent.blog.intro}
>
  <Header locale={locale} content={pageContent} otherLocalePath="/en/blog/" />
  <main class="wrap flex flex-col gap-12 pb-24 pt-[140px]">
    <div class="flex flex-wrap items-baseline gap-10">
      <div class="label-col">{pageContent.blogTeaser.label}</div>
      <div class="content-col flex flex-col gap-5">
        <h1 class="text-[clamp(44px,6vw,72px)] leading-[0.95] font-medium tracking-[-0.04em]">{pageContent.blog.heading}</h1>
        <p class="max-w-[620px] text-[clamp(18px,2vw,22px)] leading-[1.4] text-ink-soft text-pretty">{pageContent.blog.intro}</p>
      </div>
    </div>
    {
      posts.length === 0 ? (
        <p class="text-muted">{pageContent.blog.emptyState}</p>
      ) : (
        <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5">
          {posts.map((post) => <BlogCard locale={locale} post={post} readMore={pageContent.blogTeaser.readMore} />)}
        </div>
      )
    }
  </main>
  <Footer content={pageContent} locale={locale} />
</Layout>

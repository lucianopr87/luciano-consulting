---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';
import { getCollection } from 'astro:content';

const locale = 'es';
const pageContent = content[locale];

const posts = (await getCollection('blog', ({ data }) => data.lang === locale && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('es-AR', { dateStyle: 'long', timeZone: 'UTC' });
---

<Layout
  locale={locale}
  content={pageContent}
  path="/blog/"
  title={`${pageContent.blog.heading} — ${pageContent.meta.title}`}
  description={pageContent.blog.intro}
>
  <Header locale={locale} content={pageContent} otherLocalePath="/en/blog/" />
  <main class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-3xl font-bold text-slate-900">{pageContent.blog.heading}</h1>
    <p class="mt-4 text-slate-600">{pageContent.blog.intro}</p>
    {
      posts.length === 0 ? (
        <p class="mt-12 text-slate-500">{pageContent.blog.emptyState}</p>
      ) : (
        <ul class="mt-12 space-y-10">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group block">
                <h2 class="text-xl font-semibold text-slate-900 group-hover:text-slate-600">
                  {post.data.title}
                </h2>
                <p class="mt-1 text-sm text-slate-400">{dateFormatter.format(post.data.pubDate)}</p>
                <p class="mt-2 text-slate-600">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
  <Footer content={pageContent} locale={locale} />
</Layout>

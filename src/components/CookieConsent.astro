---
import type { Locale, SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const privacyHref = locale === 'es' ? '/privacy/' : '/en/privacy/';
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-50 hidden flex-col gap-3 border-t border-slate-700 bg-brand-navy px-6 py-4 text-sm text-slate-300 sm:flex-row sm:items-center sm:justify-between"
>
  <p>
    {content.cookieConsent.message}
    {' '}
    <a href={privacyHref} class="underline hover:text-white">{content.cookieConsent.policyLinkText}</a>
  </p>
  <div class="flex shrink-0 gap-3">
    <button
      id="cookie-dismiss"
      type="button"
      class="rounded-full bg-white px-4 py-1.5 font-semibold text-brand-navy hover:bg-slate-200"
    >
      {content.cookieConsent.dismissLabel}
    </button>
  </div>
</div>

<script>
  const DISMISS_KEY = 'cookie-notice-dismissed';
  const banner = document.getElementById('cookie-consent');
  const dismissButton = document.getElementById('cookie-dismiss');

  if (!localStorage.getItem(DISMISS_KEY)) {
    banner?.classList.replace('hidden', 'flex');
  }

  dismissButton?.addEventListener('click', () => {
    localStorage.setItem(DISMISS_KEY, '1');
    banner?.classList.replace('flex', 'hidden');
  });
</script>

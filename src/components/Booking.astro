---
import { sectionIds, type SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const t = content.booking;
const bookingEndpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
const bookingEnv = import.meta.env.PUBLIC_BOOKING_ENV ?? 'production';

const inputClass =
  'w-full min-w-0 rounded-md border border-night-line bg-night px-3.5 py-3 text-[15px] text-paper placeholder:text-night-label outline-none focus:border-accent-light';
---

<section id={sectionIds.booking} class="bg-night text-paper">
  <div class="wrap flex flex-wrap gap-14 py-24">
    <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-5">
      <span class="font-mono text-xs tracking-[0.08em] text-night-label">{t.label}</span>
      <h2 class="text-[clamp(34px,4.4vw,54px)] leading-[1.02] font-medium tracking-[-0.035em]">{t.heading}</h2>
      <p class="max-w-[440px] text-[17px] leading-[1.6] text-night-text text-pretty">{t.intro}</p>
      <ul class="flex flex-col gap-2 pt-2 text-[15px] text-night-text">
        {t.bullets.map((bullet) => <li>· {bullet}</li>)}
      </ul>
    </div>

    <div
      class="booking-widget box-border min-w-0 flex-[1.4_1_460px] rounded-md border border-night-line bg-night-panel p-7"
      data-endpoint={bookingEndpoint}
      data-env={bookingEnv}
      data-no-slots={t.noSlots}
      data-load-error={t.loadError}
      data-select-prompt={t.selectPrompt}
      data-time-suffix={t.timeSuffix}
      data-success-summary={t.successSummary}
    >
      <form
        class="booking-form flex flex-col gap-6"
        data-error={t.formError}
        data-slot-taken={t.slotTakenError}
        data-invalid-slot={t.invalidSlotError}
        data-rate-limited={t.rateLimitedError}
      >
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <p class="slots-status hidden text-[15px] leading-[1.6] text-night-text" role="status"></p>

        <fieldset class="slots-step flex min-w-0 flex-col gap-3">
          <legend class="mb-3 text-sm text-night-text">{t.stepDay}</legend>
          <div class="day-list flex gap-2 overflow-x-auto pb-1" aria-busy="true">
            {
              Array.from({ length: 6 }).map(() => (
                <span class="skeleton h-[74px] flex-[0_0_64px] animate-pulse rounded-md border border-night-line bg-night-line/40" />
              ))
            }
          </div>
        </fieldset>

        <fieldset class="slots-step flex min-w-0 flex-col gap-3">
          <legend class="mb-3 text-sm text-night-text">{t.stepTime}</legend>
          <div class="time-grid grid grid-cols-[repeat(auto-fill,minmax(84px,1fr))] gap-2" aria-busy="true">
            {
              Array.from({ length: 8 }).map(() => (
                <span class="skeleton h-[41px] animate-pulse rounded-md border border-night-line bg-night-line/40" />
              ))
            }
          </div>
        </fieldset>

        <fieldset class="flex min-w-0 flex-col gap-3">
          <legend class="mb-3 text-sm text-night-text">{t.stepDetails}</legend>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-2.5">
            <input name="name" type="text" required autocomplete="name" placeholder={t.namePlaceholder} aria-label={t.namePlaceholder} class={inputClass} />
            <input name="email" type="email" required autocomplete="email" placeholder={t.emailPlaceholder} aria-label={t.emailPlaceholder} class={inputClass} />
          </div>
          <input name="message" type="text" placeholder={t.topicPlaceholder} aria-label={t.topicPlaceholder} class={inputClass} />
        </fieldset>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
          <span class="selection-label text-sm text-night-text" aria-live="polite">{t.selectPrompt}</span>
          <button
            type="submit"
            disabled
            class="cursor-pointer rounded-full bg-accent px-[22px] py-[13px] text-[15px] font-medium text-white transition-colors duration-150 hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-45 disabled:hover:bg-accent"
          >
            {t.submit}
          </button>
        </div>

        <p class="form-status hidden text-sm text-accent-light" role="alert"></p>
      </form>

      <div class="confirmation hidden flex-col gap-4 py-6" role="status">
        <span class="flex size-10 items-center justify-center rounded-full bg-ok text-xl text-white" aria-hidden="true">✓</span>
        <h3 class="text-[28px] font-medium tracking-[-0.02em]">{t.successTitle}</h3>
        <p class="confirmation-summary text-base leading-[1.6] text-night-text"></p>
        <a class="confirmation-meet hidden break-all text-sm text-accent-light underline" target="_blank" rel="noopener noreferrer"
          >{t.meetLinkLabel}</a
        >
        <button
          type="button"
          class="booking-reset cursor-pointer self-start rounded-full border border-[#5a5650] px-[18px] py-2.5 text-sm text-paper hover:border-paper"
        >
          {t.reset}
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  interface Slot {
    start: string;
    end: string;
  }

  const widget = document.querySelector<HTMLDivElement>('.booking-widget');

  if (widget) {
    const endpoint = widget.dataset.endpoint ?? '';
    const env = widget.dataset.env ?? 'production';
    const timeSuffix = widget.dataset.timeSuffix ?? '';

    const form = widget.querySelector<HTMLFormElement>('.booking-form')!;
    const slotsStatus = widget.querySelector<HTMLParagraphElement>('.slots-status')!;
    const slotsSteps = widget.querySelectorAll<HTMLFieldSetElement>('.slots-step');
    const dayList = widget.querySelector<HTMLDivElement>('.day-list')!;
    const timeGrid = widget.querySelector<HTMLDivElement>('.time-grid')!;
    const selectionLabel = widget.querySelector<HTMLSpanElement>('.selection-label')!;
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLParagraphElement>('.form-status')!;
    const confirmation = widget.querySelector<HTMLDivElement>('.confirmation')!;
    const confirmationSummary = widget.querySelector<HTMLParagraphElement>('.confirmation-summary')!;
    const confirmationMeet = widget.querySelector<HTMLAnchorElement>('.confirmation-meet')!;
    const resetButton = widget.querySelector<HTMLButtonElement>('.booking-reset')!;

    const skeletonDays = dayList.innerHTML;
    const skeletonTimes = timeGrid.innerHTML;

    let slotsByDay = new Map<string, Slot[]>();
    let selectedDay: string | null = null;
    let selectedSlot: Slot | null = null;

    const locale = document.documentElement.lang || 'es';
    const timeZone = 'America/Argentina/Buenos_Aires';
    const dayKeyFormatter = new Intl.DateTimeFormat('en-CA', { timeZone, year: 'numeric', month: '2-digit', day: '2-digit' });
    const weekdayFormatter = new Intl.DateTimeFormat(locale, { timeZone, weekday: 'short' });
    const dayNumberFormatter = new Intl.DateTimeFormat(locale, { timeZone, day: 'numeric' });
    const monthFormatter = new Intl.DateTimeFormat(locale, { timeZone, month: 'short' });
    const longDayFormatter = new Intl.DateTimeFormat(locale, { timeZone, weekday: 'long', day: 'numeric', month: 'long' });
    const timeFormatter = new Intl.DateTimeFormat(locale, { timeZone, hour: '2-digit', minute: '2-digit' });

    const dayKey = (slot: Slot) => dayKeyFormatter.format(new Date(slot.start));
    const dayDate = (key: string) => new Date(`${key}T12:00:00Z`);
    const stripDot = (value: string) => value.replace('.', '');
    const formatTime = (slot: Slot) => timeFormatter.format(new Date(slot.start));
    const formatTimeWithSuffix = (slot: Slot) => [formatTime(slot), timeSuffix].filter(Boolean).join(' ');
    const formatLongDay = (slot: Slot) => longDayFormatter.format(new Date(slot.start));

    const dayButtonClass = (on: boolean) =>
      `day-option flex flex-[0_0_64px] cursor-pointer flex-col items-center gap-0.5 rounded-md border py-2.5 transition-colors duration-150 ${
        on ? 'border-paper bg-paper text-ink' : 'border-night-line bg-transparent text-paper hover:border-night-label'
      }`;
    const timeButtonClass = (on: boolean) =>
      `time-option cursor-pointer rounded-md border py-2.5 font-mono text-sm transition-colors duration-150 ${
        on ? 'border-accent bg-accent text-white' : 'border-night-line bg-transparent text-paper hover:border-night-label'
      }`;

    const setStatus = (element: HTMLElement, message: string) => {
      element.textContent = message;
      element.classList.toggle('hidden', !message);
    };

    const updateSelection = () => {
      submitButton.disabled = !selectedSlot;
      selectionLabel.textContent = selectedSlot
        ? `${formatLongDay(selectedSlot)} · ${formatTimeWithSuffix(selectedSlot)}`
        : widget.dataset.selectPrompt ?? '';
    };

    const renderTimes = () => {
      timeGrid.innerHTML = '';
      timeGrid.removeAttribute('aria-busy');
      (slotsByDay.get(selectedDay ?? '') ?? []).forEach((slot) => {
        const on = selectedSlot?.start === slot.start;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = timeButtonClass(on);
        button.textContent = formatTime(slot);
        button.dataset.start = slot.start;
        button.setAttribute('aria-pressed', String(on));
        button.addEventListener('click', () => {
          selectedSlot = slot;
          setStatus(status, '');
          renderTimes();
          updateSelection();
        });
        timeGrid.appendChild(button);
      });
    };

    const renderDays = () => {
      dayList.innerHTML = '';
      dayList.removeAttribute('aria-busy');
      slotsByDay.forEach((_slots, key) => {
        const on = key === selectedDay;
        const date = dayDate(key);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = dayButtonClass(on);
        button.dataset.day = key;
        button.setAttribute('aria-pressed', String(on));
        button.setAttribute('aria-label', longDayFormatter.format(date));
        [
          ['font-mono text-[11px] uppercase tracking-[0.04em]', stripDot(weekdayFormatter.format(date))],
          ['text-xl font-medium', dayNumberFormatter.format(date)],
          ['text-[11px]', stripDot(monthFormatter.format(date))],
        ].forEach(([className, text]) => {
          const span = document.createElement('span');
          span.className = className;
          span.textContent = text;
          button.appendChild(span);
        });
        button.addEventListener('click', () => {
          if (selectedDay === key) return;
          // Switching days invalidates whatever time was picked for the previous
          // day — force a fresh selection instead of silently submitting a stale
          // slot from a day the visitor is no longer looking at.
          selectedDay = key;
          selectedSlot = null;
          renderDays();
          renderTimes();
          updateSelection();
        });
        dayList.appendChild(button);
      });
    };

    const showSkeleton = () => {
      dayList.innerHTML = skeletonDays;
      timeGrid.innerHTML = skeletonTimes;
      dayList.setAttribute('aria-busy', 'true');
      timeGrid.setAttribute('aria-busy', 'true');
      slotsSteps.forEach((step) => step.classList.remove('hidden'));
      setStatus(slotsStatus, '');
    };

    const showSlots = (slots: Slot[]) => {
      slotsByDay = new Map();
      slots.forEach((slot) => {
        const key = dayKey(slot);
        slotsByDay.set(key, [...(slotsByDay.get(key) ?? []), slot]);
      });

      if (slotsByDay.size === 0) {
        slotsSteps.forEach((step) => step.classList.add('hidden'));
        setStatus(slotsStatus, widget.dataset.noSlots ?? '');
        return;
      }

      if (!selectedDay || !slotsByDay.has(selectedDay)) selectedDay = slotsByDay.keys().next().value ?? null;
      if (selectedSlot && !(slotsByDay.get(selectedDay ?? '') ?? []).some((slot) => slot.start === selectedSlot?.start)) {
        selectedSlot = null;
      }
      renderDays();
      renderTimes();
      updateSelection();
    };

    const loadSlots = async () => {
      showSkeleton();
      try {
        const response = await fetch(endpoint, { method: 'GET' });
        const data = await response.json();
        showSlots(data.slots ?? []);
      } catch {
        slotsSteps.forEach((step) => step.classList.add('hidden'));
        setStatus(slotsStatus, widget.dataset.loadError ?? '');
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!selectedSlot) return;

      const slot = selectedSlot;
      const formData = new FormData(form);
      const payload = {
        slotStart: slot.start,
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
        botcheck: formData.get('botcheck'),
        env,
      };

      submitButton.disabled = true;
      setStatus(status, '');

      try {
        // Content-Type: text/plain avoids a CORS preflight against the Apps Script
        // Web App, which doesn't handle OPTIONS requests.
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (result.success) {
          confirmationSummary.textContent = (widget.dataset.successSummary ?? '')
            .replace('{name}', String(payload.name ?? ''))
            .replace('{date}', formatLongDay(slot))
            .replace('{time}', formatTime(slot))
            .replace('{email}', String(payload.email ?? ''));
          confirmationMeet.classList.toggle('hidden', !result.meetLink);
          if (result.meetLink) confirmationMeet.href = result.meetLink;
          form.classList.add('hidden');
          confirmation.classList.replace('hidden', 'flex');
          selectedSlot = null;
          window.gtag?.('event', 'booking_confirmed');
          return;
        }

        let message = form.dataset.error ?? '';
        if (result.error === 'slot_taken' || result.error === 'invalid_slot') {
          message = (result.error === 'slot_taken' ? form.dataset.slotTaken : form.dataset.invalidSlot) ?? message;
          selectedSlot = null;
          loadSlots();
        } else if (result.error === 'rate_limited') {
          message = form.dataset.rateLimited ?? message;
        }
        setStatus(status, message);
      } catch {
        setStatus(status, form.dataset.error ?? '');
      } finally {
        updateSelection();
      }
    });

    resetButton.addEventListener('click', () => {
      form.reset();
      confirmation.classList.replace('flex', 'hidden');
      form.classList.remove('hidden');
      selectedSlot = null;
      updateSelection();
      loadSlots();
    });

    loadSlots();
  }
</script>

---
import type { SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const bookingEndpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
const bookingEnv = import.meta.env.PUBLIC_BOOKING_ENV ?? 'production';
---

<section class="mx-auto max-w-3xl px-6 py-24">
  <h1 class="text-3xl font-bold text-slate-900">{content.booking.heading}</h1>
  <p class="mt-3 text-slate-600">{content.booking.intro}</p>
  <p class="mt-1 text-sm text-slate-400">{content.booking.timezoneNote}</p>

  <div
    class="booking-widget mt-10"
    data-endpoint={bookingEndpoint}
    data-env={bookingEnv}
    data-no-slots={content.booking.noSlots}
    data-load-error={content.booking.loadError}
    data-time-placeholder={content.booking.timePlaceholder}
  >
    <div class="slots-step">
      <div class="slots-status flex items-center gap-2 text-sm text-slate-500">
        <svg class="loading-spinner h-4 w-4 animate-spin text-brand-teal" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span class="slots-status-text">{content.booking.loading}</span>
      </div>
      <div class="day-picker hidden">
        <div>
          <label for="booking-day" class="mb-1 block text-sm font-medium text-slate-700">{content.booking.dayLabel}</label>
          <select
            id="booking-day"
            class="day-select w-full max-w-xs rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-brand-teal focus:outline-none"
          ></select>
        </div>

        <div class="mt-4">
          <label for="booking-time" class="mb-1 block text-sm font-medium text-slate-700">{content.booking.timeLabel}</label>
          <select
            id="booking-time"
            class="time-select w-full max-w-xs rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-brand-teal focus:outline-none"
          >
            <option value="">{content.booking.timePlaceholder}</option>
          </select>
        </div>
      </div>
    </div>

    <form
      class="booking-form mt-8 hidden space-y-5"
      data-success={content.booking.formSuccess}
      data-error={content.booking.formError}
      data-slot-taken={content.booking.slotTakenError}
      data-rate-limited={content.booking.rateLimitedError}
    >
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
      <p class="selected-slot-label text-sm font-medium text-slate-700"></p>

      <div>
        <label for="booking-name" class="mb-1 block text-sm font-medium text-slate-700">{content.booking.formName}</label>
        <input
          id="booking-name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-brand-teal focus:outline-none"
        />
      </div>

      <div>
        <label for="booking-email" class="mb-1 block text-sm font-medium text-slate-700">{content.booking.formEmail}</label>
        <input
          id="booking-email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-brand-teal focus:outline-none"
        />
      </div>

      <div>
        <label for="booking-message" class="mb-1 block text-sm font-medium text-slate-700">{content.booking.formMessage}</label>
        <textarea
          id="booking-message"
          name="message"
          rows="4"
          class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-brand-teal focus:outline-none"
        ></textarea>
      </div>

      <div class="flex items-center gap-4">
        <button type="button" class="back-to-slots text-sm text-slate-500 hover:text-slate-700">
          {content.booking.backToSlots}
        </button>
        <button
          type="submit"
          class="rounded-full bg-brand-teal px-8 py-3 font-semibold text-brand-navy transition hover:opacity-90 disabled:opacity-50"
        >
          {content.booking.formSubmit}
        </button>
      </div>

      <p class="form-status hidden text-sm" role="status"></p>
    </form>

    <div class="confirmation hidden mt-8 rounded-lg border border-emerald-200 bg-emerald-50 p-6 text-emerald-900"></div>
  </div>
</section>

<script>
  interface Slot {
    start: string;
    end: string;
  }

  const widget = document.querySelector<HTMLDivElement>('.booking-widget');

  if (widget) {
    const endpoint = widget.dataset.endpoint ?? '';
    const env = widget.dataset.env ?? 'production';

    const slotsStatus = widget.querySelector<HTMLDivElement>('.slots-status');
    const slotsStatusText = widget.querySelector<HTMLSpanElement>('.slots-status-text');
    const loadingSpinner = widget.querySelector<HTMLElement>('.loading-spinner');
    const dayPicker = widget.querySelector<HTMLDivElement>('.day-picker');
    const daySelect = widget.querySelector<HTMLSelectElement>('.day-select');
    const timeSelect = widget.querySelector<HTMLSelectElement>('.time-select');
    const form = widget.querySelector<HTMLFormElement>('.booking-form');
    const selectedSlotLabel = widget.querySelector<HTMLParagraphElement>('.selected-slot-label');
    const status = widget.querySelector<HTMLParagraphElement>('.form-status');
    const confirmation = widget.querySelector<HTMLDivElement>('.confirmation');
    const backButton = widget.querySelector<HTMLButtonElement>('.back-to-slots');

    let selectedSlot: Slot | null = null;
    let slotsByDay = new Map<string, Slot[]>();

    const locale = document.documentElement.lang || 'es';
    const dayKeyFormatter = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Argentina/Buenos_Aires',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    });
    const dayLabelFormatter = new Intl.DateTimeFormat(locale, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      timeZone: 'America/Argentina/Buenos_Aires',
    });
    const timeFormatter = new Intl.DateTimeFormat(locale, {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'America/Argentina/Buenos_Aires',
    });

    const dayKey = (slot: Slot) => dayKeyFormatter.format(new Date(slot.start));
    const formatDayLabel = (key: string) => dayLabelFormatter.format(new Date(`${key}T12:00:00Z`));
    const formatTime = (slot: Slot) => timeFormatter.format(new Date(slot.start));
    const formatSlot = (slot: Slot) => `${formatDayLabel(dayKey(slot))}, ${formatTime(slot)}`;

    const selectSlot = (slot: Slot) => {
      selectedSlot = slot;
      if (selectedSlotLabel) selectedSlotLabel.textContent = formatSlot(slot);
      form?.classList.remove('hidden');
      form?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const showTimesForDay = (key: string) => {
      if (!timeSelect) return;
      timeSelect.innerHTML = '';

      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = widget.dataset.timePlaceholder ?? '';
      placeholder.selected = true;
      timeSelect.appendChild(placeholder);

      (slotsByDay.get(key) ?? []).forEach((slot) => {
        const option = document.createElement('option');
        option.value = slot.start;
        option.textContent = formatTime(slot);
        timeSelect.appendChild(option);
      });
    };

    const showSlots = (slots: Slot[]) => {
      if (!slotsStatus || !dayPicker || !daySelect) return;

      loadingSpinner?.classList.add('hidden');

      if (slots.length === 0) {
        if (slotsStatusText) slotsStatusText.textContent = widget.dataset.noSlots ?? '';
        dayPicker.classList.add('hidden');
        return;
      }

      slotsByDay = new Map();
      slots.forEach((slot) => {
        const key = dayKey(slot);
        const existing = slotsByDay.get(key) ?? [];
        existing.push(slot);
        slotsByDay.set(key, existing);
      });

      slotsStatus.classList.add('hidden');
      daySelect.innerHTML = '';
      slotsByDay.forEach((_daySlots, key) => {
        const option = document.createElement('option');
        option.value = key;
        option.textContent = formatDayLabel(key);
        daySelect.appendChild(option);
      });

      dayPicker.classList.remove('hidden');
      showTimesForDay(daySelect.value);
    };

    daySelect?.addEventListener('change', () => {
      // Switching days invalidates whatever time was picked for the previous
      // day — force a fresh selection instead of silently submitting a stale
      // slot from a day the visitor is no longer looking at.
      selectedSlot = null;
      form?.classList.add('hidden');
      showTimesForDay(daySelect.value);
    });

    timeSelect?.addEventListener('change', () => {
      if (!timeSelect.value) {
        selectedSlot = null;
        form?.classList.add('hidden');
        return;
      }
      const slot = (slotsByDay.get(daySelect?.value ?? '') ?? []).find((candidate) => candidate.start === timeSelect.value);
      if (slot) selectSlot(slot);
    });

    const loadSlots = async () => {
      try {
        const response = await fetch(endpoint, { method: 'GET' });
        const data = await response.json();
        showSlots(data.slots ?? []);
      } catch {
        loadingSpinner?.classList.add('hidden');
        if (slotsStatusText) slotsStatusText.textContent = widget.dataset.loadError ?? '';
        slotsStatus?.classList.remove('hidden');
      }
    };

    backButton?.addEventListener('click', () => {
      form?.classList.add('hidden');
      selectedSlot = null;
      if (timeSelect) timeSelect.value = '';
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!selectedSlot) return;

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const formData = new FormData(form);
      const payload = {
        slotStart: selectedSlot.start,
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
        botcheck: formData.get('botcheck'),
        env,
      };

      if (submitButton) submitButton.disabled = true;
      if (status) status.classList.add('hidden');

      try {
        // Content-Type: text/plain avoids a CORS preflight against the Apps Script
        // Web App, which doesn't handle OPTIONS requests.
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (result.success) {
          selectedSlot = null;
          if (timeSelect) timeSelect.value = '';
          form.classList.add('hidden');
          if (confirmation) {
            confirmation.innerHTML = '';
            const message = document.createElement('p');
            message.textContent = form.dataset.success ?? '';
            confirmation.appendChild(message);
            if (result.meetLink) {
              const link = document.createElement('a');
              link.href = result.meetLink;
              link.textContent = result.meetLink;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              link.className = 'mt-2 block break-all text-brand-teal underline';
              confirmation.appendChild(link);
            }
            confirmation.classList.remove('hidden');
          }
          window.gtag?.('event', 'booking_confirmed');
        } else if (status) {
          let message = form.dataset.error ?? '';
          if (result.error === 'slot_taken') {
            message = form.dataset.slotTaken ?? message;
            loadSlots();
          } else if (result.error === 'rate_limited') {
            message = form.dataset.rateLimited ?? message;
          }
          status.textContent = message;
          status.classList.remove('hidden');
          status.classList.add('text-red-500');
        }
      } catch {
        if (status) {
          status.textContent = form.dataset.error ?? '';
          status.classList.remove('hidden');
          status.classList.add('text-red-500');
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });

    loadSlots();
  }
</script>

---
import type { SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="about" class="bg-slate-50 py-24">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-3xl font-bold text-slate-900">{content.about.heading}</h2>
    <div class="mt-6 space-y-5 text-lg leading-relaxed text-slate-700">
      {content.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

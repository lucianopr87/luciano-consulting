---
import { sectionIds, type SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id={sectionIds.profile} class="border-t border-line">
  <div class="wrap flex flex-wrap gap-10 py-[88px]">
    <div class="label-col">{content.profile.label}</div>
    <div class="content-col flex flex-col gap-[22px]">
      <p class="text-[clamp(24px,2.8vw,34px)] leading-[1.3] tracking-[-0.02em] text-pretty">{content.profile.lead}</p>
      <p class="max-w-[680px] text-[17px] leading-[1.65] text-ink-soft text-pretty">{content.profile.body}</p>
    </div>
  </div>
</section>

---
import { sectionIds, type SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id={sectionIds.education} class="border-t border-line">
  <div class="wrap flex flex-wrap gap-10 py-[88px]">
    <div class="label-col">{content.education.label}</div>
    <div class="content-col flex flex-col gap-12">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-x-8">
        {
          content.education.items.map((item) => (
            <div class="flex justify-between gap-4 border-t border-line py-4">
              <div class="flex flex-col gap-1">
                <span class="text-base font-medium tracking-[-0.01em]">{item.name}</span>
                <span class="text-sm text-muted">{item.org}</span>
              </div>
              <span class="whitespace-nowrap pt-[3px] font-mono text-xs text-muted">{item.year}</span>
            </div>
          ))
        }
      </div>
      <div class="flex flex-col gap-3.5">
        <h3 class="text-[15px] font-medium">{content.education.languagesHeading}</h3>
        <div class="flex flex-wrap gap-3">
          {
            content.education.languages.map((language) => (
              <div class="flex items-baseline gap-3 rounded border border-line-2 bg-surface px-[18px] py-3.5">
                <span class="text-base font-medium">{language.name}</span>
                <span class="text-sm text-muted">{language.level}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

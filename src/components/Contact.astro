---
import type { SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---

<section id="contact" class="bg-brand-navy py-24">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-3xl font-bold text-white">{content.contact.heading}</h2>
    <p class="mt-3 text-slate-300">{content.contact.intro}</p>

    <form class="contact-form mt-10 space-y-5" data-success={content.contact.formSuccess} data-error={content.contact.formError}>
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="New message from luciano-consulting.web.app" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-slate-200">{content.contact.formName}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-2.5 text-white placeholder-slate-500 focus:border-blue-400 focus:outline-none"
        />
      </div>

      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-slate-200">{content.contact.formEmail}</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-2.5 text-white placeholder-slate-500 focus:border-blue-400 focus:outline-none"
        />
      </div>

      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-slate-200">{content.contact.formMessage}</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-2.5 text-white placeholder-slate-500 focus:border-blue-400 focus:outline-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="rounded-full bg-blue-500 px-8 py-3 font-semibold text-white transition hover:bg-blue-400 disabled:opacity-50"
      >
        {content.contact.formSubmit}
      </button>

      <p class="form-status hidden text-sm" role="status"></p>
    </form>

    <div class="mt-16 border-t border-slate-700 pt-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-slate-400">{content.contact.directHeading}</p>
      <div class="mt-3 flex flex-col gap-2 text-slate-200 sm:flex-row sm:gap-8">
        <a href={`mailto:${content.contact.email}`} class="hover:text-white">{content.contact.email}</a>
        <a href="https://www.linkedin.com/in/luciano-perez-ruiz" target="_blank" rel="noopener noreferrer" class="hover:text-white">
          {content.contact.linkedin}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('.contact-form');

  forms.forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLParagraphElement>('.form-status');
      const successMessage = form.dataset.success ?? '';
      const errorMessage = form.dataset.error ?? '';

      if (submitButton) submitButton.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        });
        const result = await response.json();

        if (status) {
          status.textContent = result.success ? successMessage : errorMessage;
          status.classList.remove('hidden');
          status.classList.toggle('text-emerald-400', Boolean(result.success));
          status.classList.toggle('text-red-400', !result.success);
        }

        if (result.success) form.reset();
      } catch {
        if (status) {
          status.textContent = errorMessage;
          status.classList.remove('hidden');
          status.classList.add('text-red-400');
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  });
</script>

---
import type { SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="services" class="mx-auto max-w-5xl px-6 py-24">
  <h2 class="text-3xl font-bold text-slate-900">{content.services.heading}</h2>
  <p class="mt-3 max-w-2xl text-slate-600">{content.services.intro}</p>

  <div class="mt-12 grid gap-8 md:grid-cols-2">
    {
      content.services.items.map((item) => (
        <div class="rounded-2xl border border-slate-200 p-8 shadow-sm">
          <h3 class="text-xl font-bold text-slate-900">{item.title}</h3>
          <p class="mt-3 text-slate-600">{item.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <span class="rounded-full bg-brand-blue/10 px-3 py-1 text-xs font-semibold text-brand-blue">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

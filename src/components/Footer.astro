---
import type { Locale, SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const privacyHref = locale === 'es' ? '/privacy/' : '/en/privacy/';
---

<footer class="bg-brand-navy py-8 text-center text-sm text-slate-400">
  <p>{content.footer.text} · {new Date().getFullYear()}</p>
  <p class="mt-2">
    <a href={privacyHref} class="underline hover:text-slate-200">{content.footer.privacyLink}</a>
  </p>
</footer>

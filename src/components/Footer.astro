---
import { sectionIds, type Locale, type SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const homePath = locale === 'es' ? '/' : '/en/';
const privacyHref = locale === 'es' ? '/privacy/' : '/en/privacy/';
---

<footer class="border-t border-line">
  <div class="wrap flex flex-wrap justify-between gap-3 py-7 text-sm text-muted">
    <span>© {new Date().getFullYear()} Luciano Perez Ruiz · {content.footer.role}</span>
    <div class="flex flex-wrap gap-6">
      <a href={privacyHref} class="text-muted hover:text-accent">{content.footer.privacyLink}</a>
      <a href={`${homePath}#${sectionIds.home}`} class="text-muted hover:text-accent">{content.footer.backToTop}</a>
    </div>
  </div>
</footer>

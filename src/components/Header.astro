---
import { contactDetails, sectionIds, type Locale, type SectionKey, type SiteContent } from '../i18n/content';

interface Props {
  locale: Locale;
  content: SiteContent;
  otherLocalePath?: string;
  /** Page whose sections the menu links to. Defaults to the locale's home. */
  sectionsPath?: string;
}

const { locale, content, otherLocalePath, sectionsPath } = Astro.props;
const homePath = locale === 'es' ? '/' : '/en/';
const otherLocale = locale === 'es' ? 'en' : 'es';
const resolvedOtherLocalePath = otherLocalePath ?? (otherLocale === 'es' ? '/' : '/en/');

const navKeys = Object.keys(sectionIds) as SectionKey[];
const navLinks = navKeys.map((key, index) => ({
  num: String(index).padStart(2, '0'),
  label: content.nav.items[key],
  href: `${sectionsPath ?? homePath}#${sectionIds[key]}`,
}));
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md">
  <div class="wrap flex items-center justify-between gap-4 py-3.5">
    <a href={`${homePath}#${sectionIds.home}`} class="flex min-w-0 items-center gap-3 text-ink hover:text-ink">
      <span
        class="flex size-[34px] flex-none items-center justify-center rounded-full bg-ink font-mono text-xs tracking-[0.02em] text-paper"
        aria-hidden="true">LPR</span
      >
      <span class="sr-only min-w-0 truncate text-[15px] font-medium tracking-[-0.01em] sm:not-sr-only">Luciano Perez Ruiz</span>
    </a>
    <div class="flex flex-none items-center gap-2.5">
      <nav
        id="lang-switch"
        aria-label={content.nav.languageSwitch}
        class="flex items-center rounded-full border border-line-4 p-[3px] font-mono text-xs tracking-[0.04em]"
      >
        {
          (['es', 'en'] as const).map((code) =>
            code === locale ? (
              <span aria-current="true" class="rounded-full bg-ink px-2 py-[5px] text-paper sm:px-2.5">
                {code.toUpperCase()}
              </span>
            ) : (
              <a
                href={resolvedOtherLocalePath}
                hreflang={code}
                lang={code}
                aria-label={content.nav.otherLanguage}
                class="rounded-full px-2 py-[5px] text-muted sm:px-2.5 transition-colors duration-150 hover:text-ink"
              >
                {code.toUpperCase()}
              </a>
            ),
          )
        }
      </nav>
      <a
        href={`${sectionsPath ?? homePath}#${sectionIds.booking}`}
        class="whitespace-nowrap rounded-full border border-ink px-3.5 py-[9px] sm:px-4 text-sm text-ink transition-colors duration-150 hover:bg-ink hover:text-paper"
      >
        {content.nav.bookShort}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex cursor-pointer items-center gap-2.5 py-[9px] pl-1.5 pr-1 text-sm text-ink sm:pl-2.5"
        aria-expanded="false"
        aria-controls="site-menu"
        data-label-open={content.nav.menu}
        data-label-close={content.nav.close}
      >
        <span id="menu-toggle-label" class="sr-only sm:not-sr-only">{content.nav.menu}</span>
        <span class="flex w-[22px] flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-[1.5px] bg-ink"></span>
          <span class="ml-2 block h-[1.5px] w-3.5 bg-ink"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div id="site-menu" class="fixed inset-0 z-[35] hidden overflow-auto bg-night text-paper" hidden>
  <div class="wrap flex flex-wrap justify-between gap-12 pb-12 pt-[120px]">
    <nav class="flex flex-[1_1_420px] flex-col gap-1" aria-label={content.nav.menu}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="menu-link flex items-baseline gap-5 py-1 text-[clamp(34px,5vw,56px)] leading-[1.2] font-normal tracking-[-0.03em] text-paper transition-colors duration-150 hover:text-accent-light"
          >
            <span class="w-6 font-mono text-[13px] tracking-normal text-night-label">{link.num}</span>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex flex-[0_1_300px] flex-col gap-3.5 pt-3 text-[15px]">
      <span class="font-mono text-xs tracking-[0.08em] text-night-label">{content.nav.directContact}</span>
      <a href={`mailto:${contactDetails.email}`} class="text-paper hover:text-accent-light">{contactDetails.email}</a>
      <a href={contactDetails.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-paper hover:text-accent-light">
        LinkedIn ↗
      </a>
      <a href={content.cvPdf} target="_blank" class="text-paper hover:text-accent-light">{content.nav.downloadCv}</a>
      <a
        href={resolvedOtherLocalePath}
        hreflang={otherLocale}
        lang={otherLocale}
        class="mt-4 self-start rounded-full border border-night-line px-4 py-2 text-sm text-paper hover:border-paper hover:text-paper"
      >
        <span class="mr-2 font-mono text-xs text-night-label">{otherLocale.toUpperCase()}</span>{content.nav.otherLanguage}
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const toggleLabel = document.getElementById('menu-toggle-label');
  const menu = document.getElementById('site-menu');

  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    if (toggleLabel) {
      toggleLabel.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    }
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

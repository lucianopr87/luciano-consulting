---
import type { SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="experience" class="mx-auto max-w-3xl px-6 py-24">
  <h2 class="text-3xl font-bold text-slate-900">{content.experience.heading}</h2>
  <p class="mt-3 text-slate-600">{content.experience.intro}</p>

  <ol class="mt-12 space-y-10 border-l border-slate-200 pl-8">
    {
      content.experience.items.map((item) => (
        <li class="relative">
          <span class="absolute -left-[2.28rem] top-1.5 h-3 w-3 rounded-full bg-brand-blue" />
          <p class="text-sm font-semibold text-brand-blue">{item.period}</p>
          <h3 class="mt-1 text-lg font-bold text-slate-900">
            {item.role} · {item.company}
          </h3>
          <p class="mt-2 text-slate-600">{item.description}</p>
          {item.highlights && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-600">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</section>

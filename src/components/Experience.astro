---
import { sectionIds, type SiteContent } from '../i18n/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id={sectionIds.experience} class="border-t border-line">
  <div class="wrap flex flex-wrap items-baseline gap-10 pb-10 pt-[88px]">
    <div class="label-col">{content.experience.label}</div>
    <h2 class="content-col text-[clamp(32px,4vw,48px)] leading-[1.05] font-medium tracking-[-0.035em]">
      {content.experience.heading}
    </h2>
  </div>
  <div class="wrap pb-[72px]">
    {
      content.experience.items.map((job) => (
        <article class="flex flex-wrap gap-10 border-t border-line py-9">
          <div class="flex flex-[1_1_220px] flex-col gap-1.5">
            <span class="font-mono text-[13px] text-muted">{job.years}</span>
            <span class="text-xl font-medium tracking-[-0.02em]">{job.company}</span>
            {job.link && (
              <a href={job.link.href} target="_blank" rel="noopener" class="text-sm text-accent hover:text-accent-hover">
                {job.link.label}
              </a>
            )}
          </div>
          <div class="content-col flex flex-col gap-3.5">
            <h3 class="text-xl font-medium tracking-[-0.015em]">{job.role}</h3>
            <p class="max-w-[680px] text-base leading-[1.65] text-ink-soft text-pretty">{job.description}</p>
            {job.highlights?.map((highlight) => (
              <div class="flex max-w-[680px] gap-[18px] pt-3">
                <span class="flex-[0_0_40px] pt-1 font-mono text-xs text-accent">{highlight.year}</span>
                <span class="text-[15px] leading-[1.6] text-pretty">{highlight.text}</span>
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>
